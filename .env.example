# Database (PostgreSQL). Bij Supabase: Project Settings > Database > Connection string (URI).
# Bij docker-compose wordt deze automatisch overschreven.
DATABASE_URL="postgresql://stal:stal@localhost:5432/stalbeheer"

# Geheime sleutel voor inlogsessies. Genereer bv. met: openssl rand -hex 32
AUTH_SECRET="vervang-dit-door-een-lange-willekeurige-string"

# Map waar geüploade bestanden (foto's, video's, röntgen) worden opgeslagen.
# Lokaal: ./uploads. Op een server: een pad op een schijf met voldoende ruimte.
UPLOAD_DIR="./uploads"

# Eerste eigenaar-account (wordt aangemaakt bij `npm run db:seed`)
SEED_OWNER_NAME="Eigenaar"
SEED_OWNER_EMAIL="eigenaar@voorbeeld.nl"
SEED_OWNER_PASSWORD="wachtwoord123"

# --- Koppelingen: kun je ook invullen bij Instellingen > Koppelingen in de app ---
# FleetGo (aanvragen via info@fleetgo.com)
FLEETGO_CLIENT_ID=""
FLEETGO_CLIENT_SECRET=""
FLEETGO_USERNAME=""
FLEETGO_PASSWORD=""

# Equipe (personal access token met scope "read", via online.equipe.com)
EQUIPE_TOKEN=""

# WhatsApp Business Cloud API (Meta for Developers)
WHATSAPP_VERIFY_TOKEN="kies-zelf-een-geheim-woord"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""

# RVO I&R webservice (PKI-overheid certificaat, aanvragen via dr.fab.edv@rvo.nl)
RVO_UBN=""
RVO_CERT_PATH=""
RVO_KEY_PATH=""
RVO_ENDPOINT=""

# Geheim voor de dagelijkse synchronisatie (/api/sync). Leeg = AUTH_SECRET wordt gebruikt.
SYNC_SECRET=""
# Tijdzone voor weergave en dagplanning
APP_TIMEZONE="Europe/Amsterdam"
