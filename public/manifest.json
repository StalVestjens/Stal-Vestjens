{
  "name": "Stalbeheer",
  "short_name": "Stalbeheer",
  "description": "Managementplatform voor de paardenhouderij",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f6f4ef",
  "theme_color": "#1f3a2c",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "/api/delen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "files", "accept": ["image/*", "video/*", "application/pdf"] }]
    }
  }
}
